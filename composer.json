{
  "name": "tina4stack/tina4php-orm",
  "description": "Tina4 ORM Module",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "Tina4\\": [
        "Tina4/"
      ]
    }
  },
    "require": {
        "php": ">=8.1"
    },
  "require-dev": {
    "roave/security-advisories": "dev-latest",
    "phpunit/phpunit": "^9",
    "overtrue/phplint": "^2.0",
    "tina4stack/tina4php-firebird": "^2.0",
    "phpmetrics/phpmetrics": "^2.8"
  },
  "scripts": {
    "test": "./vendor/bin/phpunit tests --color --log-junit=tests/junit.xml",
    "phpmetrics": "./vendor/bin/phpmetrics --report-html=phpmetrics --junit=tests/junit.xml ./Tina4"
  }
}
